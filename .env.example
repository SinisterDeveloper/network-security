# --- Server Configuration ---
SERVER_PORT=3000
# Optional: restrict CORS to these comma-separated origins (empty = allow all)
CORS_ORIGINS=
# Optional: shared secret for /admin/* — require X-Admin-Key header when set
ADMIN_KEY=change-me

# --- Gateway Configuration ---
GATEWAY_PORT=8824
# The base URL where the gateway forwards requests (usually the server)
FORWARD_BASE=http://localhost:3000

# --- Blockchain Configuration ---
# Polygon Amoy RPC URL
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# Private key for deployment and transactions
PRIVATE_KEY=
# Deployed contract address (fill this after deployment)
CONTRACT_ADDRESS=
