#pragma once

// Copy this file to config.h and fill in your environment.
// config.h is gitignored — never commit real credentials.

// WiFi — provision at build time. For production, use WiFiManager or NVS.
#define WIFI_SSID       "AYULAPTOP"
#define WIFI_PASSWORD   "LAPTOPAYU"

// Gateway / Server endpoints
// Gateway is stateless firewall (Phase 2) — forwardBase is server, but ESP talks to gateway.
#define GATEWAY_HOST    "10.10.11.3"
#define GATEWAY_PORT    8824
#define GATEWAY_DATA_PATH   "/data"
#define GATEWAY_ENCRYPT_PATH "/encrypt"

// Server direct (fallback if gateway encrypt shim unavailable)
#define SERVER_HOST     "10.10.11.3"
#define SERVER_PORT     3000

// Optional: hardcode ML-KEM-768 public key (1184B base64). If empty, firmware fetches
// via POST http://GATEWAY_HOST:GATEWAY_PORT/client/publicKey  {mac}  or via gateway shim.
// Keeping it empty is recommended — avoids stale keys after device re-registration.
#define HARDCODED_PUBLIC_KEY ""

// Timing
#define WIFI_CONNECT_TIMEOUT_MS 15000
#define HTTP_TIMEOUT_MS         5000
#define LOOP_INTERVAL_MS        5000

// Feature toggles
// #define USE_TLS  // uncomment to use WiFiClientSecure + cert (requires server TLS)
// #define DEBUG_PUF_DUMP  // dump PUF over Serial on boot
